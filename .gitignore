# 依赖
node_modules/

# 你的配置（含 QQ 号与 token）与隐私扫描规则
config.json
config.json.bak*
scripts/privacy-rules.json

# 运行状态：情绪、因果、日志、会话、聊天记录
state/
qq-bridge/state/

# 角色与她的人格/记忆 —— 属于你，不属于仓库
roles/*.md
!roles/_TEMPLATE.md
!roles/_TEMPLATE.规则.md
!roles/README.md
!roles/傲娇助手.md

# 角色包（记忆卡、B站账本、快照）
characters/
~/.dsh/surfcore/

# 备份与临时
*.bak
*.bak-*
*.log
.DS_Store
Thumbs.db
